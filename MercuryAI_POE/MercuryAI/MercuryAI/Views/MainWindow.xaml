<Window x:Class="MercuryAI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mercury AI — Cybersecurity Awareness Bot"
        Height="800" Width="1120"
        MinHeight="600" MinWidth="840"
        WindowStartupLocation="CenterScreen"
        Background="#080D18"
        FontFamily="Segoe UI">

    <Window.Resources>

        <Style x:Key="BtnBase" TargetType="Button">
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnCyan" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background"  Value="#0A2030"/>
            <Setter Property="Foreground"  Value="#00E5FF"/>
            <Setter Property="BorderBrush" Value="#00E5FF"/>
            <Setter Property="Padding"     Value="12,7,12,7"/>
            <Setter Property="FontSize"    Value="12"/>
        </Style>

        <Style x:Key="BtnSend" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background"  Value="#082014"/>
            <Setter Property="Foreground"  Value="#00E676"/>
            <Setter Property="BorderBrush" Value="#00E676"/>
            <Setter Property="Padding"     Value="22,10,22,10"/>
            <Setter Property="FontSize"    Value="13"/>
        </Style>

        <Style x:Key="BtnRed" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background"  Value="#1A0808"/>
            <Setter Property="Foreground"  Value="#FF5252"/>
            <Setter Property="BorderBrush" Value="#FF5252"/>
            <Setter Property="Padding"     Value="12,7,12,7"/>
            <Setter Property="FontSize"    Value="12"/>
        </Style>

        <Style x:Key="TopicChip" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background"  Value="#0C1525"/>
            <Setter Property="Foreground"  Value="#7A8498"/>
            <Setter Property="BorderBrush" Value="#162030"/>
            <Setter Property="Padding"     Value="9,5,9,5"/>
            <Setter Property="FontSize"    Value="11"/>
            <Setter Property="Margin"      Value="2,2,2,2"/>
        </Style>

        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Background"      Value="#0F1A2E"/>
            <Setter Property="Foreground"      Value="#FFFFFF"/>
            <Setter Property="CaretBrush"      Value="#00E5FF"/>
            <Setter Property="BorderBrush"     Value="#00E5FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Padding"         Value="12,10,12,10"/>
            <Setter Property="SelectionBrush"  Value="#00E5FF"/>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="265"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border Grid.Column="0"
                Background="#060B14"
                BorderBrush="#162030"
                BorderThickness="0,0,1,0">
            <DockPanel>

                <!-- Logo -->
                <Border DockPanel.Dock="Top"
                        Background="#04080F"
                        Padding="16,22,16,18"
                        BorderBrush="#162030"
                        BorderThickness="0,0,0,1">
                    <StackPanel>
                        <Border Background="#0A2030"
                                CornerRadius="30"
                                Width="60" Height="60"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,10">
                            <Border.Effect>
                                <DropShadowEffect Color="#00E5FF" BlurRadius="16"
                                                  ShadowDepth="0" Opacity="0.4"/>
                            </Border.Effect>
                            <TextBlock Text="🐵" FontSize="30"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="MERCURY AI"
                                   FontSize="18" FontWeight="Bold"
                                   Foreground="#00E5FF"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Cybersecurity Awareness Bot"
                                   FontSize="9.5" Foreground="#7A8498"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,10"/>
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center">
                            <Ellipse Width="7" Height="7" Fill="#00E676"
                                     VerticalAlignment="Center"
                                     Margin="0,0,5,0">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#00E676"
                                                      BlurRadius="6" ShadowDepth="0"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <TextBlock Text="ONLINE"
                                       Foreground="#00E676"
                                       FontSize="9" FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Memory Panel -->
                <Border DockPanel.Dock="Top"
                        Margin="10,12,10,0"
                        Padding="12,10,12,10"
                        Background="#04080F"
                        BorderBrush="#162030"
                        BorderThickness="1"
                        CornerRadius="5">
                    <StackPanel>
                        <TextBlock Text="🧠  SESSION MEMORY"
                                   Foreground="#00E5FF"
                                   FontSize="9.5" FontWeight="Bold"
                                   Margin="0,0,0,7"/>
                        <TextBlock x:Name="MemoryLabel"
                                   Text="No data saved yet."
                                   Foreground="#7A8498" FontSize="11"
                                   TextWrapping="Wrap" LineHeight="17"/>
                    </StackPanel>
                </Border>

                <!-- Topics heading -->
                <TextBlock DockPanel.Dock="Top"
                           Text="QUICK TOPICS"
                           Foreground="#7A8498"
                           FontSize="9" FontWeight="Bold"
                           Margin="14,14,14,4"/>

                <!-- Topic chips -->
                <ScrollViewer DockPanel.Dock="Top"
                              VerticalScrollBarVisibility="Auto"
                              Margin="6,0,6,0"
                              MaxHeight="260">
                    <WrapPanel x:Name="TopicPanel" Margin="4"/>
                </ScrollViewer>

                <!-- Action buttons -->
                <StackPanel DockPanel.Dock="Bottom"
                            Margin="10,0,10,14">
                    <Separator Background="#162030" Margin="0,8,0,10"/>
                    <Button x:Name="BtnAddTask"
                            Content="➕  Add Task"
                            Style="{StaticResource BtnCyan}"
                            Margin="0,0,0,5"
                            Click="BtnAddTask_Click"/>
                    <Button x:Name="BtnShowTasks"
                            Content="📋  View Tasks"
                            Style="{StaticResource BtnCyan}"
                            Margin="0,0,0,5"
                            Click="BtnShowTasks_Click"/>
                    <Button x:Name="BtnStartQuiz"
                            Content="🎯  Start Quiz"
                            Style="{StaticResource BtnCyan}"
                            Margin="0,0,0,5"
                            Click="BtnStartQuiz_Click"/>
                    <Button x:Name="BtnActivityLog"
                            Content="📜  Activity Log"
                            Style="{StaticResource BtnCyan}"
                            Margin="0,0,0,5"
                            Click="BtnActivityLog_Click"/>
                    <Separator Background="#162030" Margin="0,4,0,10"/>
                    <Button x:Name="BtnClear"
                            Content="🗑  Clear Chat"
                            Style="{StaticResource BtnCyan}"
                            Margin="0,0,0,5"
                            Click="BtnClear_Click"/>
                    <Button x:Name="BtnHelp"
                            Content="📋  Topic Menu"
                            Style="{StaticResource BtnCyan}"
                            Margin="0,0,0,5"
                            Click="BtnHelp_Click"/>
                    <Button x:Name="BtnMemory"
                            Content="🧠  What Do You Remember?"
                            Style="{StaticResource BtnCyan}"
                            Margin="0,0,0,5"
                            Click="BtnMemory_Click"/>
                    <Button x:Name="BtnExit"
                            Content="✕  Exit"
                            Style="{StaticResource BtnRed}"
                            Click="BtnExit_Click"/>
                </StackPanel>

            </DockPanel>
        </Border>

        <!-- MAIN CHAT AREA -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Top bar -->
            <Border Grid.Row="0"
                    Background="#04080F"
                    BorderBrush="#162030"
                    BorderThickness="0,0,0,1"
                    Padding="18,0,18,0">
                <DockPanel VerticalAlignment="Center">
                    <TextBlock Text="💬  CHAT"
                               Foreground="#00E5FF"
                               FontSize="11" FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusLabel"
                               Text="Type your name to begin"
                               Foreground="#7A8498" FontSize="11"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"
                               DockPanel.Dock="Right"/>
                </DockPanel>
            </Border>

            <!-- Chat scroll area -->
            <ScrollViewer Grid.Row="1"
                          x:Name="ChatScroll"
                          Background="#080D18"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="16,10,16,10">
                <StackPanel x:Name="ChatPanel" Margin="0,4,0,4"/>
            </ScrollViewer>

            <!-- Input bar -->
            <Border Grid.Row="2"
                    Background="#04080F"
                    BorderBrush="#162030"
                    BorderThickness="0,1,0,0"
                    Padding="14,12,14,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             x:Name="UserInput"
                             Style="{StaticResource InputStyle}"
                             Height="44"
                             VerticalContentAlignment="Center"
                             KeyDown="UserInput_KeyDown"/>
                    <Button Grid.Column="1"
                            x:Name="BtnSend"
                            Content="➤  SEND"
                            Style="{StaticResource BtnSend}"
                            Height="44"
                            Margin="10,0,0,0"
                            Click="BtnSend_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>